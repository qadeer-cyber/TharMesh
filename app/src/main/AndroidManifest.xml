<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="tharmesh.app">

    <!-- Internet is required for one-time Google sign-in; mesh operates offline. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Bluetooth for Nearby Connections, Android <12. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- Bluetooth for Nearby Connections, Android 12+. -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />

    <!-- Wi-Fi for Nearby Connections. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- Location permissions needed for Bluetooth LE scanning on most OEMs. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Camera for QR code scanning in ScanQrActivity. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Stage 6.3 Disaster Mode — vibration alert on incoming SOS-priority bundles.
         Normal-protection permission, granted at install time. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name="com.tharmesh.TharMeshApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TharMesh"
        tools:ignore="UnusedAttribute">

        <!-- Diagnostic crash viewer. Uses the platform default theme
             (android:theme="@android:style/Theme.Material") so it can
             be shown even if the app's own theme is what's crashing. -->
        <activity
            android:name="com.tharmesh.diagnostics.CrashViewerActivity"
            android:theme="@android:style/Theme.Material"
            android:exported="false" />
        <activity android:name="com.tharmesh.ui.auth.LoginActivity" />
        <activity android:name="com.tharmesh.ui.status.StatusActivity" />
        <activity android:name="com.tharmesh.ui.groups.GroupsActivity" />
        <activity android:name="com.tharmesh.ui.contacts.ScanQrActivity" />
        <activity android:name="com.tharmesh.ui.contacts.MyQrActivity" />
        <activity
            android:name="com.tharmesh.ui.onboarding.OnboardingActivity"
            android:screenOrientation="portrait" />
        <activity android:name="com.tharmesh.ui.contacts.ContactsActivity" />
        <activity android:name="com.tharmesh.ui.contacts.ContactProfileActivity" />
        <activity android:name="com.tharmesh.ui.devices.DevicesActivity" />
        <activity android:name="com.tharmesh.ui.chat.ChatActivity" />
        <activity android:name="com.tharmesh.ui.chats.ChatsActivity" />
        <activity android:name="com.tharmesh.ui.diagnostics.DiagnosticsActivity" />
        <activity android:name="com.tharmesh.ui.profile.ProfileActivity" />
        <activity android:name="com.tharmesh.ui.settings.SettingsSectionActivity" />
        <activity android:name="com.tharmesh.ui.about.AboutActivity" />
        <!-- Stage 8.4 — Pakistan legal defensibility hardening. -->
        <activity android:name="com.tharmesh.ui.legal.TermsActivity" />
        <activity android:name="com.tharmesh.ui.legal.LegalDocActivity" />
        <activity android:name="com.tharmesh.ui.legal.BlockedContactsActivity" />
        <activity android:name="com.tharmesh.ui.main.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
