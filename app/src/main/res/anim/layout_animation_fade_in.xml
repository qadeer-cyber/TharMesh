<?xml version="1.0" encoding="utf-8"?>
<!--
  Stage 7.6 — RecyclerView layout animation. Fires once on initial
  population (chats / contacts / devices). The 20% delay between rows
  produces a tasteful staggered fade without dragging perceived load
  time past the brief's 180ms ceiling for any single row.
-->
<layoutAnimation xmlns:android="http://schemas.android.com/apk/res/android"
    android:animation="@anim/item_fade_in"
    android:animationOrder="normal"
    android:delay="20%" />
