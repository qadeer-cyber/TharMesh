<?xml version="1.0" encoding="utf-8"?>
<!--
  Stage 9.2 — chat bubble appearance animation. New messages enter the
  RecyclerView with a scale 0.92 → 1.0 + fade 0 → 1 over 220ms with a
  decelerate interpolator. Wired in the chat adapter via
  RecyclerView.itemAnimator. Property-only — no layout/measure passes —
  so insertions remain 60fps even on the iMac Mid 2010 emulator.
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false"
    android:fillAfter="true">
    <scale
        android:fromXScale="0.92"
        android:toXScale="1.0"
        android:fromYScale="0.92"
        android:toYScale="1.0"
        android:pivotX="50%"
        android:pivotY="100%"
        android:duration="220"
        android:interpolator="@android:anim/decelerate_interpolator" />
    <alpha
        android:fromAlpha="0.0"
        android:toAlpha="1.0"
        android:duration="220" />
</set>
