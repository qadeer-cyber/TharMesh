<?xml version="1.0" encoding="utf-8"?>
<!--
  Stage 7.6 — press feedback for primary buttons. Scales 1.0 → 0.97 in
  120ms on press, returns to 1.0 in 180ms on release. Both are inside
  the brief's micro-motion budget. Property-only (no layout pass), so
  no overdraw or layout-thrashing impact.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator
                android:propertyName="scaleX"
                android:duration="120"
                android:valueTo="0.97"
                android:valueType="floatType" />
            <objectAnimator
                android:propertyName="scaleY"
                android:duration="120"
                android:valueTo="0.97"
                android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator
                android:propertyName="scaleX"
                android:duration="180"
                android:valueTo="1.0"
                android:valueType="floatType" />
            <objectAnimator
                android:propertyName="scaleY"
                android:duration="180"
                android:valueTo="1.0"
                android:valueType="floatType" />
        </set>
    </item>
</selector>
