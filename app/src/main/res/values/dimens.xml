<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Stage 7.5 — single source of truth for spacing + typography tokens.
      Layouts that adopt these stay rhythmically aligned across screens
      without ad-hoc padding values. Existing layouts that hard-code
      8dp/12dp/16dp continue to work; this file just gives new + polished
      callers a name to reach for.
    -->

    <!-- 8dp grid system. Use these names instead of raw dp values. -->
    <dimen name="tm_space_xs">4dp</dimen>
    <dimen name="tm_space_s">8dp</dimen>
    <dimen name="tm_space_m">12dp</dimen>
    <dimen name="tm_space_l">16dp</dimen>
    <dimen name="tm_space_xl">20dp</dimen>
    <dimen name="tm_space_xxl">24dp</dimen>

    <!-- Typography scale per Stage 7.5 brief.
         meta_xs (11sp) — kept for the bubble timestamp + tick row only;
                          everywhere else should be meta_s or meta_l. -->
    <dimen name="tm_text_meta_xs">11sp</dimen>
    <dimen name="tm_text_meta_s">12sp</dimen>
    <dimen name="tm_text_meta_l">13sp</dimen>
    <dimen name="tm_text_body">14sp</dimen>
    <dimen name="tm_text_body_l">15sp</dimen>
    <dimen name="tm_text_name">16sp</dimen>
    <dimen name="tm_text_title_s">18sp</dimen>
    <dimen name="tm_text_title">20sp</dimen>

    <!-- Standard touch-target sizes. -->
    <dimen name="tm_icon_s">20dp</dimen>
    <dimen name="tm_icon">24dp</dimen>
    <dimen name="tm_avatar_s">40dp</dimen>
    <dimen name="tm_avatar">48dp</dimen>

    <!-- Chat row + list row baseline heights. -->
    <dimen name="tm_row_min_height">72dp</dimen>
    <dimen name="tm_row_settings_min_height">68dp</dimen>
</resources>
