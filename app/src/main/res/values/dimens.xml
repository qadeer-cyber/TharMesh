<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Stage 7.5 — single source of truth for spacing + typography tokens.
      Layouts that adopt these stay rhythmically aligned across screens
      without ad-hoc padding values. Existing layouts that hard-code
      8dp/12dp/16dp continue to work; this file just gives new + polished
      callers a name to reach for.
    -->

    <!-- 8dp grid system. Use these names instead of raw dp values. -->
    <dimen name="tm_space_xs">4dp</dimen>
    <dimen name="tm_space_s">8dp</dimen>
    <dimen name="tm_space_m">12dp</dimen>
    <dimen name="tm_space_l">16dp</dimen>
    <dimen name="tm_space_xl">20dp</dimen>
    <dimen name="tm_space_xxl">24dp</dimen>
    <dimen name="tm_space_xxxl">32dp</dimen>

    <!-- Typography scale per Stage 7.5 brief.
         Bubble timestamps + ticks intentionally use meta_s (12sp) for
         contrast against the new pale green; meta_xs (11sp) is reserved
         for very dense secondary metadata (badges, tags). -->
    <dimen name="tm_text_meta_xs">11sp</dimen>
    <dimen name="tm_text_meta_s">12sp</dimen>
    <dimen name="tm_text_meta_l">13sp</dimen>
    <dimen name="tm_text_body">14sp</dimen>
    <dimen name="tm_text_body_l">15sp</dimen>
    <dimen name="tm_text_name">16sp</dimen>
    <dimen name="tm_text_title_s">18sp</dimen>
    <dimen name="tm_text_title">20sp</dimen>

    <!-- Standard touch-target sizes. -->
    <dimen name="tm_icon_s">20dp</dimen>
    <dimen name="tm_icon">24dp</dimen>
    <dimen name="tm_avatar_s">40dp</dimen>
    <dimen name="tm_avatar">48dp</dimen>

    <!-- Chat row + list row baseline heights. -->
    <dimen name="tm_row_min_height">72dp</dimen>
    <dimen name="tm_row_settings_min_height">68dp</dimen>

    <!--
      Stage 7.6 — three-level depth system.
        Level 0: screen background (no elevation)
        Level 1: cards / list rows / message bubbles
        Level 2: active elements (FAB resting, top bar shadow seam)
        Level 2 pressed: FAB / button press
      Used consistently so depth reads coherent across the app.
    -->
    <dimen name="tm_elev_card">2dp</dimen>
    <dimen name="tm_elev_top_bar">2dp</dimen>
    <dimen name="tm_elev_fab">6dp</dimen>
    <!-- Note: pressedTranslationZ is the *additional* Z on press, so this
         gives a total pressed elevation of tm_elev_fab + this value. -->
    <dimen name="tm_elev_fab_pressed_translation">4dp</dimen>

    <!-- Stage 7.6 — bubble max width (75% of typical 360dp viewport).
         Applied on the text_body TextView in item_msg_me / item_msg_peer
         (LinearLayout silently ignores android:maxWidth, so the cap lives
         on the TextView and the wrap_content bubble parent collapses
         around it). Long messages wrap into multi-line columns instead
         of dragging the bubble across the entire screen. -->
    <dimen name="tm_bubble_max_width">270dp</dimen>
</resources>
