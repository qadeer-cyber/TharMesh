<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Premium dark theme. We inherit from the Material Components NoActionBar
        parent so the Material bottom nav and buttons continue to work, then
        override surface/background/accent colors for the "offline mesh" look.
    -->
    <style name="Theme.TharMesh" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/tm_neon_cyan</item>
        <item name="colorPrimaryVariant">@color/tm_neon_cyan_dim</item>
        <item name="colorOnPrimary">@color/tm_bg</item>
        <item name="colorSecondary">@color/tm_neon_green</item>
        <item name="colorSecondaryVariant">@color/tm_neon_green_dim</item>
        <item name="colorOnSecondary">@color/tm_bg</item>
        <item name="colorSurface">@color/tm_surface</item>
        <item name="colorOnSurface">@color/tm_text_primary</item>
        <item name="android:colorBackground">@color/tm_bg</item>
        <item name="android:textColorPrimary">@color/tm_text_primary</item>
        <item name="android:textColorSecondary">@color/tm_text_secondary</item>
        <item name="android:windowBackground">@color/tm_bg</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/tm_bg</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/tm_bg</item>
    </style>
</resources>
