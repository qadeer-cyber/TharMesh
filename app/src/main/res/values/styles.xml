<resources>
    <!-- Typography -->
    <style name="Text.Title" parent="TextAppearance.AppCompat.Title">
        <item name="android:textColor">@color/tm_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Subtle" parent="TextAppearance.AppCompat.Body2">
        <item name="android:textColor">@color/tm_text_secondary</item>
    </style>

    <style name="Text.H1" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/tm_text_primary</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="Text.H2" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/tm_text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.H3" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/tm_text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Body" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/tm_text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Text.Caption" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/tm_text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Text.Tag" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/tm_neon_cyan</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Cards -->
    <style name="TmCard">
        <item name="android:background">@drawable/bg_card_glass</item>
        <item name="android:padding">16dp</item>
    </style>

    <!-- Buttons -->
    <style name="TmButton.Primary" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/tm_bg</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
    </style>

    <style name="TmButton.Ghost" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_ghost</item>
        <item name="android:textColor">@color/tm_text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>
