<?xml version="1.0" encoding="utf-8"?>
<!--
  Stage 6.1 — bottom nav tint resolves from theme attrs so the WhatsApp-green
  accent is used in light mode and the neon cyan in dark mode without a
  separate values-night/ override.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="?attr/tmNeonGreen" android:state_checked="true" />
    <item android:color="?attr/tmTextMuted" />
</selector>
