<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/tmBg"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/tmBg"
        android:padding="16dp"
        android:text="@string/contacts_title"
        android:textColor="?attr/tmTextPrimary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edit_search_contacts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:background="?attr/tmSurface"
        android:hint="@string/contacts_search_hint"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:padding="10dp"
        android:textColor="?attr/tmTextPrimary"
        android:textColorHint="?attr/tmTextSecondary"
        android:textSize="14sp" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/contacts_filter_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:singleSelection="true"
        app:selectionRequired="true"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_all"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/contacts_filter_all" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_online"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/contacts_filter_online" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_verified"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/contacts_filter_verified" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_unverified"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/contacts_filter_unverified" />
    </com.google.android.material.chip.ChipGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/tmSurface"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/btn_my_qr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/contacts_my_qr" />

        <Button
            android:id="@+id/btn_scan_qr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/contacts_scan_qr" />

        <Button
            android:id="@+id/btn_add_invite"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/contacts_add_by_invite" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_contacts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layoutAnimation="@anim/layout_animation_fade_in" />

        <LinearLayout
            android:id="@+id/empty_contacts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/tm_space_xxl"
            android:visibility="gone">

            <TextView
                style="@style/Text.H2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/contacts_empty_title" />

            <TextView
                style="@style/Text.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tm_space_s"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/contacts_empty_subtitle" />

            <!-- Stage 8.0 — actionable empty state. Pre-8.0 the empty state
                 was just text + subtitle, leaving a brand-new user with no
                 obvious next step. Two primary CTAs match the spec exactly:
                 Scan QR (start ScanQrActivity) and Find nearby (open the
                 DevicePickerSheet). Both buttons reuse the existing handlers
                 in [ContactsFragment]; no new logic, just direct entry
                 points from the empty state body. -->
            <Button
                android:id="@+id/empty_btn_scan_qr"
                style="@style/TmButton.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tm_space_l"
                android:minWidth="200dp"
                android:text="@string/contacts_scan_qr" />

            <Button
                android:id="@+id/empty_btn_find_nearby"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tm_space_s"
                android:minWidth="200dp"
                android:text="@string/new_chat_action_find_nearby" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
