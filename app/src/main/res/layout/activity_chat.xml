<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!-- Top bar: avatar + name + status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/tmBg2"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/tm_space_m"
        android:paddingEnd="@dimen/tm_space_l"
        android:paddingTop="@dimen/tm_space_m"
        android:paddingBottom="@dimen/tm_space_m">

        <TextView
            android:id="@+id/text_chat_avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_avatar"
            android:gravity="center"
            android:text="A"
            android:textColor="@android:color/white"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_chat_title"
                style="@style/Text.Name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Contact" />

            <TextView
                android:id="@+id/text_top_status"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/tmNeonGreen"
                android:text="@string/chat_header_offline" />
        </LinearLayout>

        <ImageView
            android:id="@+id/icon_chat_shield"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_shield_outline"
            android:contentDescription="@string/cd_shield_tofu" />
    </LinearLayout>

    <!-- E2EE banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/tmBg2"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_lock" />

        <TextView
            style="@style/Text.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/chat_header_encrypted"
            android:textColor="?attr/tmNeonCyan" />

        <TextView
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chat_header_encrypted_sub"
            android:textColor="?attr/tmTextSecondary"
            android:textSize="11sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/tmStrokeSoft" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="8dp" />

    <LinearLayout
        android:id="@+id/reply_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/tmBg2"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <View
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:background="?attr/tmNeonCyan" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/reply_bar_author"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/tmNeonCyan"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="@string/chat_reply_to" />

            <TextView
                android:id="@+id/reply_bar_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="?attr/tmTextSecondary"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/reply_bar_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/chat_cancel_reply"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <!-- Composer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/tmBg2"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <ImageButton
            android:id="@+id/button_attach"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/chat_attach"
            android:src="@drawable/ic_attach" />

        <EditText
            android:id="@+id/edit_message"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="@string/hint_message"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="?attr/tmTextPrimary"
            android:textColorHint="?attr/tmTextMuted"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/button_send"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_fab_gradient"
            android:contentDescription="@string/chat_send"
            android:src="@drawable/ic_send" />
    </LinearLayout>

</LinearLayout>
