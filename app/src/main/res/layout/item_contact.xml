<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/tmSurface"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/tm_row_min_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/tm_space_l"
    android:paddingEnd="@dimen/tm_space_l"
    android:paddingTop="@dimen/tm_space_m"
    android:paddingBottom="@dimen/tm_space_m">

    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp">

        <TextView
            android:id="@+id/text_avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_avatar"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textStyle="bold" />

        <View
            android:id="@+id/dot_online"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_online_dot"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_name"
            style="@style/Text.Name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/text_userid"
            style="@style/Text.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/text_fingerprint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/tmTextSecondary"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/icon_trust_shield"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:visibility="gone" />

</LinearLayout>
