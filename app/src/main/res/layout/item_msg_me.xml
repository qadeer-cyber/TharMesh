<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="3dp"
    android:paddingBottom="3dp"
    android:paddingStart="56dp"
    android:paddingEnd="12dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:background="@drawable/bg_bubble_me"
        android:elevation="@dimen/tm_elev_card"
        android:orientation="vertical"
        android:paddingStart="@dimen/tm_space_m"
        android:paddingEnd="@dimen/tm_space_m"
        android:paddingTop="@dimen/tm_space_s"
        android:paddingBottom="@dimen/tm_space_s">

        <LinearLayout
            android:id="@+id/reply_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_reply_inline"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/reply_author"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/tmNeonCyan"
                android:textSize="11sp"
                android:textStyle="bold"
                android:text="Replying to" />

            <TextView
                android:id="@+id/reply_preview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="#CCE6F5FF"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/tm_bubble_max_width"
            android:textColor="?attr/tmBubbleTextMe"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="6dp"
            android:baselineAligned="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/tmTickDefault"
                android:textSize="@dimen/tm_text_meta_s" />

            <TextView
                android:id="@+id/text_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="?attr/tmTickDefault"
                android:textSize="@dimen/tm_text_meta_s"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
