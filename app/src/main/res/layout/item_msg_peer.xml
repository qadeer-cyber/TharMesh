<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:paddingStart="8dp"
    android:paddingEnd="48dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:background="@drawable/bg_bubble_peer"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:id="@+id/reply_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#22000000"
            android:orientation="vertical"
            android:padding="6dp"
            android:visibility="gone"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/reply_author"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/tm_accent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:text="Replying to" />

            <TextView
                android:id="@+id/reply_preview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/tm_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/tm_text_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/text_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:textColor="@color/tm_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

</FrameLayout>
