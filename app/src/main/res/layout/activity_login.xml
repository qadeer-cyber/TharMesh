<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/tmBg"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="48dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <ImageView
        android:id="@+id/login_logo"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="@string/cd_logo"
        android:src="@drawable/ic_logo_mark" />

    <TextView
        android:id="@+id/login_title"
        style="@style/Text.H1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/app_name"
        android:textSize="34sp" />

    <TextView
        android:id="@+id/login_tagline"
        style="@style/Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/app_tagline" />

    <TextView
        android:id="@+id/login_subtagline"
        style="@style/Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/login_offline_note" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_composer"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/login_google_button"
            style="@style/TmButton.Primary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/login_continue_with_google"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/login_create_button"
            style="@style/TmButton.Primary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="@string/login_create_account"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/login_signin_button"
            style="@style/TmButton.Ghost"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="@string/login_sign_in"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/login_anonymous_button"
            style="@style/TmButton.Ghost"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/login_continue_anonymously"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/login_status"
        style="@style/Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        tools:ignore="MissingPrefix" />
</LinearLayout>
