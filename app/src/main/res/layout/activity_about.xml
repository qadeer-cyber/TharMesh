<?xml version="1.0" encoding="utf-8"?>
<!--
    Stage 10.1 — About / Founder Signature screen.

    Layered structure follows the Stage 9.2 depth rule:
      L1 — screen gradient background (?attr/tmBg → bg_screen_gradient)
      L2 — glass-floating cards (founder, story, system, links)
      L3 — interactive rows / link buttons inside the links card

    No real backdrop blur (minSdk 24); cards use the shipped faux-glass
    surfaces (bg_glass_floating / bg_glass_raised). Hero halo is a single
    radial-gradient drawable behind a circular avatar; AboutActivity owns
    a slow ObjectAnimator on its alpha (held in a field, cancelled in
    onDestroy per the leak fix from PR #46).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    android:orientation="vertical">

    <!-- Top bar: back arrow + screen title. Mirrors the rest of Settings. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/about_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/profile_back"
            android:padding="10dp"
            android:rotation="180"
            android:src="@drawable/ic_chevron_right"
            app:tint="?attr/tmTextPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/about_screen_title"
            android:textColor="?attr/tmTextPrimary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/about_root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- Hero — app icon + name + tagline.
                 The hero halo (bg_avatar_glow_online) sits as the
                 background of [hero_icon_halo] sized 160dp; the
                 launcher mipmap renders at 96dp on top, so the halo
                 forms a soft 32dp ring around the icon. -->
            <FrameLayout
                android:id="@+id/hero_icon_halo"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_avatar_glow_online">

                <ImageView
                    android:id="@+id/hero_icon"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/cd_logo"
                    android:src="@mipmap/ic_launcher_round" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:text="@string/app_name"
                android:textColor="?attr/tmTextPrimary"
                android:textSize="28sp"
                android:textStyle="bold"
                android:letterSpacing="-0.015" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:text="@string/app_subtagline"
                android:textColor="?attr/tmTextSecondary"
                android:textSize="13sp" />

            <View
                android:layout_width="48dp"
                android:layout_height="2dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_brand_accent_underline" />

            <!-- Founder card. Glass-floating surface with a circular
                 avatar (the user-supplied photo) above a kicker line,
                 the founder's name, brand, and origin. -->
            <LinearLayout
                android:id="@+id/founder_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_glass_floating"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    app:cardBackgroundColor="?attr/tmSurface"
                    app:cardCornerRadius="48dp"
                    app:cardElevation="2dp"
                    app:strokeColor="?attr/tmStrokeSoft"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/about_avatar_cd"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_founder_avatar" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/about_built_by_kicker"
                    android:textAllCaps="true"
                    android:textColor="?attr/tmNeonCyan"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10" />

                <View
                    android:layout_width="32dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_brand_accent_underline" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/about_founder_name"
                    android:textColor="?attr/tmTextPrimary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/about_founder_brand"
                    android:textColor="?attr/tmTextPrimary"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/about_founder_origin"
                    android:textColor="?attr/tmTextSecondary"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:text="@string/about_founder_microline"
                    android:textColor="?attr/tmTextSecondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Story card. -->
            <LinearLayout
                android:id="@+id/story_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_glass_floating"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_story_title"
                    android:textColor="?attr/tmTextPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/about_story_body"
                    android:textColor="?attr/tmTextPrimary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- System info card — minimal styling, secondary importance.
                 Three label/value rows. -->
            <LinearLayout
                android:id="@+id/system_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_glass_floating"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_system_title"
                    android:textColor="?attr/tmTextPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/about_system_version_label"
                        android:textColor="?attr/tmTextSecondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/about_system_version_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/tmTextPrimary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        tools:text="0.1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/about_system_buildtype_label"
                        android:textColor="?attr/tmTextSecondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/about_system_buildtype_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/tmTextPrimary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        tools:text="debug" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/about_system_commit_label"
                        android:textColor="?attr/tmTextSecondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/about_system_commit_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/tmTextPrimary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        tools:text="a9a6513" />
                </LinearLayout>
            </LinearLayout>

            <!-- Quick action links — GitHub / Telegram / WhatsApp Channel.
                 Three rows inside a glass-floating card. Each row is a
                 standalone clickable row with the premium press feedback
                 wired in code. URLs come from string resources. -->
            <LinearLayout
                android:id="@+id/links_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_glass_floating"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="6dp"
                    android:text="@string/about_links_title"
                    android:textColor="?attr/tmTextPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/about_link_github"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_github"
                        app:tint="?attr/tmTextPrimary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="@string/about_link_github"
                        android:textColor="?attr/tmTextPrimary"
                        android:textSize="14sp" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="?attr/tmTextSecondary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/about_link_telegram"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_telegram"
                        app:tint="?attr/tmTextPrimary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="@string/about_link_telegram"
                        android:textColor="?attr/tmTextPrimary"
                        android:textSize="14sp" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="?attr/tmTextSecondary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/about_link_whatsapp"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_whatsapp"
                        app:tint="?attr/tmTextPrimary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="@string/about_link_whatsapp"
                        android:textColor="?attr/tmTextPrimary"
                        android:textSize="14sp" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="?attr/tmTextSecondary" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
