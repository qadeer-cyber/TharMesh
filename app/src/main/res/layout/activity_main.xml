<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!--
      Stage 5.3 — global mesh status banner. Hidden by default; MainActivity
      flips it visible when permissions are missing / BT off / Location off,
      and otherwise shows scanning / N peers when the mesh is up. Reuses
      existing colour + typography styles; no new theme.
    -->
    <LinearLayout
        android:id="@+id/mesh_status_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:visibility="gone"
        android:background="?attr/tmBg2">

        <TextView
            android:id="@+id/mesh_status_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="?attr/tmTextPrimary"
            android:textSize="14sp"
            tools:text="Bluetooth is off — turn it on to use the mesh"
            xmlns:tools="http://schemas.android.com/tools" />

        <Button
            android:id="@+id/mesh_status_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="?attr/tmNeonCyan"
            android:background="@android:color/transparent"
            android:text="@string/banner_action_retry"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/tmStrokeSoft" />

    <!--
      Stage 6.1 — WhatsApp-style bottom nav. itemBackground paints a soft
      green pill behind the active tab (state_checked=true, see
      drawable/bg_nav_pill.xml); inactive tabs render flat. The pill is
      themed so it appears as the WhatsApp green tint in light mode and the
      neon-green-dim glow in dark mode, preserving the pre-6.1 cyber look.
    -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/tmBg"
        android:minHeight="64dp"
        app:itemBackground="@drawable/bg_nav_pill"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav" />

</LinearLayout>
