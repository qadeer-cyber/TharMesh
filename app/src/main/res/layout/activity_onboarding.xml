<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/tmBg"
    android:orientation="vertical">

    <!-- Step indicator: three pills above the content. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="24dp"
        android:paddingBottom="8dp">

        <View
            android:id="@+id/step_dot_1"
            android:layout_width="32dp"
            android:layout_height="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_step_active" />

        <View
            android:id="@+id/step_dot_2"
            android:layout_width="32dp"
            android:layout_height="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_step_inactive" />

        <View
            android:id="@+id/step_dot_3"
            android:layout_width="32dp"
            android:layout_height="6dp"
            android:background="@drawable/bg_step_inactive" />
    </LinearLayout>

    <ViewFlipper
        android:id="@+id/flipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include layout="@layout/onboarding_step_name" />

        <include layout="@layout/onboarding_step_mesh" />

        <include layout="@layout/onboarding_step_first_contact" />
    </ViewFlipper>
</LinearLayout>
