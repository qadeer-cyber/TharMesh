<?xml version="1.0" encoding="utf-8"?>
<!--
    Stage 8.4 \u2014 row layout for [BlockedContactsActivity]. Two columns:
    the blocked userId / display-name on the left, an Unblock action on
    the right.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/blocked_row_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/tmTextPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/blocked_row_userid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="?attr/tmTextSecondary"
            android:textSize="13sp" />
    </LinearLayout>

    <Button
        android:id="@+id/blocked_row_unblock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_blocked_contacts_unblock" />
</LinearLayout>
