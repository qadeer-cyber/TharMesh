<?xml version="1.0" encoding="utf-8"?>
<!--
  Stage 6.1 — WhatsApp-style Chats home.

  Top row:    large "TharMesh" title + icon row (mesh / theme-toggle / alerts /
              camera / profile / overflow).
  Search:     rounded pill with magnifier icon and "Search nearby peers or
              messages" hint. Filters the live conversation list (no fake rows).
  Filters:    horizontally-scrolling chip group (All / Unread / Nearby /
              Trusted / +). Each chip is wired to a real predicate against
              MessageRepository / NearbyDirectory / PeerIdentityDao.
  Body:       conversation list (RecyclerView) or empty state.
  FAB stack:  small new-message FAB stacked above the primary "+" FAB.

  Light/dark are theme-attribute driven; bg_screen_gradient resolves to a
  flat white in light and the pre-6.1 dark gradient in dark, and the chat
  rows themselves stay flat in light + card-glass in dark via drawable-night.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ============================================================== -->
        <!-- Top icon row — minimal: title · mesh-status · theme · avatar      -->
        <!-- · overflow. Camera moved to chat-screen attach action; alerts    -->
        <!-- moved to the dedicated bottom-nav Alerts tab.                  -->
        <!-- ============================================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="?attr/tmTextPrimary"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- Mesh status indicator: wifi icon + a small warning dot
                 overlay that flips visible when BT/Location/perms are
                 missing. Tap opens [mesh_warning_dialog]. -->
            <FrameLayout
                android:id="@+id/btn_top_mesh"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_top_icon">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/cd_mesh_status"
                    android:padding="8dp"
                    android:src="@drawable/ic_wifi" />

                <View
                    android:id="@+id/top_mesh_warning_dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_warning_dot"
                    android:visibility="gone" />
            </FrameLayout>

            <ImageView
                android:id="@+id/btn_top_theme"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_top_icon"
                android:contentDescription="@string/settings_theme"
                android:padding="8dp"
                android:src="@drawable/ic_moon" />

            <FrameLayout
                android:id="@+id/btn_top_profile"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp">

                <TextView
                    android:id="@+id/top_profile_avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_avatar"
                    android:gravity="center"
                    android:text="A"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/top_profile_avatar_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:contentDescription="@string/profile_avatar_cd" />
            </FrameLayout>

            <ImageView
                android:id="@+id/btn_top_overflow"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_top_icon"
                android:contentDescription="@string/settings_title"
                android:padding="8dp"
                android:src="@drawable/ic_more_vert" />
        </LinearLayout>

        <!-- Subtle hairline between the top bar and the search/chip stack. -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:background="?attr/tmStrokeSoft" />

        <!-- ============================================================== -->
        <!-- Search pill                                                    -->
        <!-- ============================================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_search_pill"
            android:gravity="center_vertical"
            android:minHeight="44dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/cd_search"
                android:src="@drawable/ic_search" />

            <EditText
                android:id="@+id/chats_search"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/chats_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="?attr/tmTextPrimary"
                android:textColorHint="?attr/tmTextSecondary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- ============================================================== -->
        <!-- Filter chip row                                                -->
        <!-- ============================================================== -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/chip_filter_all"
                    style="@style/TmChip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chat_filter_all" />

                <Button
                    android:id="@+id/chip_filter_unread"
                    style="@style/TmChip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chat_filter_unread" />

                <Button
                    android:id="@+id/chip_filter_nearby"
                    style="@style/TmChip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chat_filter_nearby" />

                <Button
                    android:id="@+id/chip_filter_trusted"
                    style="@style/TmChip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chat_filter_trusted" />

                <FrameLayout
                    android:id="@+id/chip_filter_plus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="2dp"
                    android:background="@drawable/bg_chip_plus">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/new_chat"
                        android:src="@drawable/ic_plus_thin" />
                </FrameLayout>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- ============================================================== -->
        <!-- Stage 7 PR D — nearby tap-to-add banner. Hidden by default;    -->
        <!-- shown when [NearbyDirectory] reports a peer not yet in the      -->
        <!-- user's contacts. Tap-to-add only — no auto-add anywhere.        -->
        <!-- ============================================================== -->
        <LinearLayout
            android:id="@+id/nearby_suggest_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_nearby_banner"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="6dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="@string/nearby_banner_icon_desc"
                android:src="@drawable/ic_wifi" />

            <TextView
                android:id="@+id/nearby_banner_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="?attr/tmTextPrimary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/nearby_banner_add"
                style="@style/TmButton.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="0dp"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp"
                android:text="@string/nearby_banner_add" />

            <ImageView
                android:id="@+id/nearby_banner_dismiss"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="2dp"
                android:contentDescription="@string/nearby_banner_dismiss_desc"
                android:padding="6dp"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <!-- ============================================================== -->
        <!-- Conversation list / empty state                                -->
        <!-- ============================================================== -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_chats"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="2dp"
                android:paddingBottom="120dp" />

            <LinearLayout
                android:id="@+id/empty_chats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/tm_space_xxl"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:background="@drawable/bg_round_icon_green">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_message" />
                </FrameLayout>

                <TextView
                    style="@style/Text.H2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tm_space_xl"
                    android:gravity="center"
                    android:text="@string/empty_chats" />

                <TextView
                    style="@style/Text.Meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tm_space_s"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/empty_chats_hint" />

                <Button
                    android:id="@+id/button_empty_start_chat"
                    style="@style/TmButton.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tm_space_xxl"
                    android:minWidth="200dp"
                    android:text="@string/empty_chats_button" />

                <Button
                    android:id="@+id/button_empty_invite"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tm_space_xs"
                    android:minWidth="200dp"
                    android:text="@string/empty_chats_invite" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- ================================================================ -->
    <!-- FAB — single "+" opens the New-chat sheet.                      -->
    <!-- ================================================================ -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_new_chat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/tm_space_l"
        android:contentDescription="@string/new_chat"
        android:src="@drawable/ic_plus"
        app:backgroundTint="?attr/tmNeonGreen"
        app:tint="?attr/tmBg"
        app:elevation="8dp"
        app:pressedTranslationZ="2dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
