<?xml version="1.0" encoding="utf-8"?>
<!--
  Glassmorphism-style card: semi-opaque dark surface + subtle cyan border and
  rounded corners. Native drawable only; no blur (not available pre-12).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/tm_surface" />
    <stroke android:width="1dp" android:color="@color/tm_stroke" />
    <corners android:radius="16dp" />
</shape>
