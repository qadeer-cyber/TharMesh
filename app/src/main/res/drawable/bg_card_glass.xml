<?xml version="1.0" encoding="utf-8"?>
<!--
  Stage 6.1 — themed surface card. Resolves to the glass-y dark surface in
  dark mode and a clean white card with a soft divider stroke in light mode.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/tmSurface" />
    <stroke android:width="1dp" android:color="?attr/tmStroke" />
    <corners android:radius="16dp" />
</shape>
