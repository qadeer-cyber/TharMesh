<?xml version="1.0" encoding="utf-8"?>
<!--
  Stage 6.1 — rounded WhatsApp-style search pill for the chats home. Resolves
  to the WhatsApp #F0F2F5 fill in light mode (via tmSearchFill) and the dark
  surface_2 in dark mode.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/tmSearchFill" />
    <corners android:radius="100dp" />
</shape>
