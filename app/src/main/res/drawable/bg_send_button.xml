<?xml version="1.0" encoding="utf-8"?>
<!--
  Stage 9.2 — selector for the chat input send button. When the host
  ImageButton is enabled (input has text), use the active gradient.
  Otherwise, render the dim idle state.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="true" android:drawable="@drawable/bg_send_button_active" />
    <item android:drawable="@drawable/bg_send_button_idle" />
</selector>
