<?xml version="1.0" encoding="utf-8"?>
<!--
  Stage 6.1 — bottom-nav active-tab pill. Light mode: soft WhatsApp-green
  fill behind the icon when checked. Dark mode: subtle cyan-glow tint so
  the pre-6.1 neon look is preserved.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/tmNeonGreenDim" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
