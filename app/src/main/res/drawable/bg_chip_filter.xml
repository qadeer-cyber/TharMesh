<?xml version="1.0" encoding="utf-8"?>
<!--
  Stage 6.1 — WhatsApp-style filter chip. Selected: accent green tint with
  matching stroke; unselected: bg-2 fill with soft stroke. Selectors apply
  to the activated state which the host fragment toggles per chip.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/tmNeonGreenDim" />
            <stroke android:width="1dp" android:color="?attr/tmNeonGreen" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/tmBg2" />
            <stroke android:width="1dp" android:color="?attr/tmStroke" />
            <corners android:radius="100dp" />
        </shape>
    </item>
</selector>
