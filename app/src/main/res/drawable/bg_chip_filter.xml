<?xml version="1.0" encoding="utf-8"?>
<!--
  WhatsApp-style filter chip. Selected state uses the soft chip-fill tint
  with no neon outline (the previous design had a saturated neon stroke
  which read as too aggressive in both light and dark). Unselected stays
  flat with a soft hairline so the row reads as a single rhythmic group.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/tmNeonGreenDim" />
            <stroke android:width="1dp" android:color="?attr/tmStroke" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/tmBg2" />
            <stroke android:width="1dp" android:color="?attr/tmStrokeSoft" />
            <corners android:radius="100dp" />
        </shape>
    </item>
</selector>
