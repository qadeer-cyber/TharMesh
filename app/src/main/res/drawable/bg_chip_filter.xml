<?xml version="1.0" encoding="utf-8"?>
<!--
  Filter chips use readable theme text and a clear selected outline.

  Selected: neutral fill + high-contrast visible outline.
  Unselected: surface-2 fill + softer hairline.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/tmBg2" />
            <stroke android:width="2dp" android:color="?attr/tmTextPrimary" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/tmBg2" />
            <stroke android:width="1dp" android:color="?attr/tmStrokeSoft" />
            <corners android:radius="100dp" />
        </shape>
    </item>
</selector>
