<?xml version="1.0" encoding="utf-8"?>
<!--
  Stage 9.2 — slightly more opaque "raised glass" used for cards that need
  to read as primary surfaces (SOS card, mesh-graph wrapper, segmented
  controls). Higher opacity than [bg_glass_floating] so text laid on top
  meets contrast targets.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/tmSurfaceGlassRaised" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="?attr/tmStroke" />
        </shape>
    </item>
</layer-list>
