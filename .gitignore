# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Log/OS Files
*.log

# Android Studio generated files and folders
captures/
.externalNativeBuild/
.cxx/
*.aab
*.apk
output-metadata.json

# IntelliJ
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Keystore files. The debug key is the public Android debug credential,
# committed so CI and Google OAuth share one SHA-1. Production keys stay ignored.
*.jks
*.keystore
!app/debug.keystore

# Google Services (e.g. APIs or Firebase)
google-services.json

# Android Profiling
*.hprof

# Supabase CLI local state. supabase/.temp holds per-machine scratch (cached
# latest-version string, pooler URLs, the linked project ref). It is written by
# any `supabase` invocation and must never be committed; the tracked source of
# truth is supabase/migrations, supabase/functions and schema.sql.
supabase/.temp/

# Python bytecode
__pycache__/
*.pyc
